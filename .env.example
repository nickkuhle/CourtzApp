# Courtz App - Google Sheets Integration
# Choose ONE method. Method 1 (WebApp) is easiest.

# METHOD 1: Apps Script Web App (RECOMMENDED - 5 min, no GCP)
# 1. Open your Sheet -> Extensions -> Apps Script -> Paste CourtzAppsScript.gs
# 2. Deploy -> New deployment -> Web app -> Execute as: Me, Who has access: Anyone
# 3. Copy the URL and paste below
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_ID=1U3TcsbIhQ9lxeo0_LtHYTldIqbkWg2Je

# METHOD 2: Google Sheets API with Service Account (alternative)
# 1. Go to console.cloud.google.com -> Enable Sheets API + Drive API
# 2. Create Service Account -> Create JSON key -> copy values below
# 3. Share your Sheet with the service account email (Editor)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=courtz-sheets@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_ID=1U3TcsbIhQ9lxeo0_LtHYTldIqbkWg2Je
# (leave SHEETS_WEBAPP_URL empty if using this method)

