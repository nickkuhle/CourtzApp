# ---------------------------------------------------------------------------
# CourtzApp — Google Sheets integration
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your values. NEVER commit .env.local
# (it is already gitignored).
#
# Full step-by-step instructions: see GOOGLE_SHEETS_INTEGRATION.md

# 1) The ID of your spreadsheet. It's the long string between "/d/" and "/edit"
#    in the spreadsheet URL:
#    https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# 2) From the service account JSON key you download from Google Cloud
#    (client_email and private_key fields):
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...your-key...\n-----END PRIVATE KEY-----\n"

# 3) Optional: override the tab names if your spreadsheet uses different ones.
# GOOGLE_SHEETS_ROSTER_TAB=Roster
# GOOGLE_SHEETS_SITES_TAB=Sites
# GOOGLE_SHEETS_RESERVATIONS_TAB=Reservations
